PORT=3000
HOST=0.0.0.0
CACHE_MAX_SIZE=500
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_RENDERS=10
RENDER_TIMEOUT_MS=10000
LOG_LEVEL=info
RATE_LIMIT_RPM=60

# Google Cloud Storage (optional — enables persistent chart storage)
# Name of a pre-existing GCS bucket. Auth via Application Default
# Credentials (gcloud auth application-default login locally, or
# a service account / workload identity in production).
# GCS_BUCKET=
